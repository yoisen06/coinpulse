# Copy this file to .env and fill in the values:  cp .env.example .env
# Get a free Demo API key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_demo_api_key_here

POSTGRES_USER=coinpulse
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=coinpulse

# Seconds to cache CoinGecko responses
CACHE_TTL_SECONDS=60
